---
const { target } = Astro.props;
---

<section class="countdown-section section-shell" aria-labelledby="countdown-title">
  <div class="countdown-copy">
    <p class="section-kicker">La cuenta regresiva</p>
    <h2 id="countdown-title">Cada vez falta menos.</h2>
    <p>Nos encontramos en la fiesta de colación para celebrar juntos este logro.</p>
  </div>
  <div class="countdown" data-countdown-target={target} aria-live="polite">
    <div class="countdown-unit"><strong data-unit="days">—</strong><span>días</span></div>
    <div class="countdown-unit"><strong data-unit="hours">—</strong><span>horas</span></div>
    <div class="countdown-unit"><strong data-unit="minutes">—</strong><span>minutos</span></div>
    <div class="countdown-unit"><strong data-unit="seconds">—</strong><span>segundos</span></div>
  </div>
</section>

<script>
  const countdown = document.querySelector<HTMLElement>('[data-countdown-target]');

  if (countdown) {
    const target = new Date(countdown.dataset.countdownTarget ?? '').getTime();
    const units = {
      days: countdown.querySelector<HTMLElement>('[data-unit="days"]'),
      hours: countdown.querySelector<HTMLElement>('[data-unit="hours"]'),
      minutes: countdown.querySelector<HTMLElement>('[data-unit="minutes"]'),
      seconds: countdown.querySelector<HTMLElement>('[data-unit="seconds"]'),
    };

    const updateCountdown = () => {
      const distance = Math.max(0, target - Date.now());
      const seconds = Math.floor(distance / 1000);
      const days = Math.floor(seconds / 86400);
      const hours = Math.floor((seconds % 86400) / 3600);
      const minutes = Math.floor((seconds % 3600) / 60);
      const remainingSeconds = seconds % 60;

      if (units.days) units.days.textContent = String(days).padStart(2, '0');
      if (units.hours) units.hours.textContent = String(hours).padStart(2, '0');
      if (units.minutes) units.minutes.textContent = String(minutes).padStart(2, '0');
      if (units.seconds) units.seconds.textContent = String(remainingSeconds).padStart(2, '0');

      if (distance === 0) {
        countdown.closest('section')?.classList.add('is-complete');
      }
    };

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
  }
</script>
