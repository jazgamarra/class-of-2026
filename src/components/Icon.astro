---
type IconName = 'arrow-down' | 'arrow-up' | 'arrow-up-right';

const { name, class: className = '' } = Astro.props as { name: IconName; class?: string };

const paths = {
  'arrow-down': '<path d="M12 4v15M5.5 12.5 12 19l6.5-6.5" />',
  'arrow-up': '<path d="M12 20V5M5.5 11.5 12 5l6.5 6.5" />',
  'arrow-up-right': '<path d="M5 19 19 5M9 5h10v10" />',
};
---

<svg class:list={['icon', className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]}></svg>
