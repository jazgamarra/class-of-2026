---
import { Image } from 'astro:assets';
import sunset from '../assets/images/group-picture-with-sunset.jpeg';
import sunsetCloser from '../assets/images/group-picture-with-sunset-closer.jpeg';
import dressedWhite from '../assets/images/group-picture-all-dressed-in-white.jpeg';

const photos = [
  { src: sunsetCloser, alt: 'La promoción reunida durante el atardecer', className: 'gallery-main' },
  { src: dressedWhite, alt: 'La promoción vestida de blanco', className: 'gallery-tall' },
  { src: sunset, alt: 'Foto grupal de la promoción al atardecer', className: 'gallery-wide' },
];
---

<section class="gallery-section section-shell" id="momentos" aria-labelledby="gallery-title">
  <div class="section-heading gallery-heading">
    <p class="section-kicker">Nuestros momentos</p>
    <h2 id="gallery-title">Lo que queda<br /><em>para siempre.</em></h2>
  </div>
  <div class="gallery-grid">
    {photos.map((photo) => (
      <button class:list={['gallery-item', photo.className]} type="button" data-gallery-src={photo.src.src} aria-label={`Ampliar: ${photo.alt}`}>
        <Image src={photo.src} alt={photo.alt} widths={[600, 1000]} sizes="(max-width: 640px) 92vw, 50vw" loading="lazy" />
      </button>
    ))}
  </div>
</section>

<dialog class="lightbox" data-lightbox>
  <button class="lightbox-close" type="button" data-lightbox-close aria-label="Cerrar imagen">×</button>
  <img data-lightbox-image alt="" />
</dialog>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxImage = document.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');

  document.querySelectorAll<HTMLButtonElement>('[data-gallery-src]').forEach((item) => {
    item.addEventListener('click', () => {
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = item.dataset.gallerySrc ?? '';
      lightboxImage.alt = item.querySelector('img')?.alt ?? '';
      lightbox.showModal();
    });
  });

  closeButton?.addEventListener('click', () => lightbox?.close());
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });
</script>
