---
import '../styles/global.css';

const { title = 'Class of 2026' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f1e8" />
    <meta name="description" content="Invitación a la colación de la Class of 2026." />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
